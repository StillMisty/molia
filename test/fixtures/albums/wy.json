erson":0,"trans":"","picId":109951172230180900,"musicSize":176,"albumSize":11,"briefDesc":"","picUrl":"https://p1.music.126.net/XSQHadsjqY8Sv8KgUkMufg==/109951172230180889.jpg","img1v1Url":"https://p1.music.126.net/OGc1zDtsJjjFChBLY4DNlQ==/109951172230182284.jpg","followed":false,"alias":[],"name":"张悬","id":10557,"picId_str":"109951172230180889","img1v1Id_str":"109951172230182284"},"briefDesc":"","publishTime":1344528000000,"company":"索尼音乐","picUrl":"https://p1.music.126.net/Baol42Xvto6rjRdj0aK_wg==/109951167778492613.jpg","commentThreadId":"R_AL_3_32311","subType":"录音室版","status":1,"description":"　这是张悬，也是你，也正是身逢这个时代的你我。\n　　读着她的词，听着她的歌，体会到张悬的作品是多么符合这个时代的产物，堪称是当代桂冠诗人歌手。\n　　你看到的，你听到的，即是你所知道的张悬，也是一部份的你自己。\n　　缘份是神，游戏，是我们。\n\n\n2012年盛夏，最令人期待的专辑之一。张悬最新作品『神的游戏』，词、曲、编曲、制作全由张悬倾注心血完成。风格独到的音乐与观点细腻的文字，第一次聆听就被深深吸引，这张专辑却同样直指人生各种境地，在时光与反复中将依旧无限耐人寻味。一如张悬历来作品的展现，此刻交出的这张作品，总括张悬三年以来个人生活的累积心得，既安稳的平心静气娓娓道来，又蓄势着蕴涵为未来将要展开的行动预备新能量。\n\n","tags":"","alias":[],"name":"神的游戏","id":32311,"type":"专辑","size":9,"picId_str":"109951167778492613","info":{"commentThread":{"id":"R_AL_3_32311","resourceInfo":{"id":32311,"userId":-1,"name":"神的游戏","imgUrl":"http://p4.music.126.net/Baol42Xvto6rjRdj0aK_wg==/109951167778492613.jpg","creator":null,"encodedId":null,"subTitle":null,"webUrl":null},"resourceType":3,"commentCount":1988,"likedCount":0,"shareCount":10339,"hotCount":125,"latestLikedUsers":null,"resourceId":32311,"resourceOwnerId":-1,"resourceTitle":"神的游戏"},"latestLikedUsers":null,"liked":false,"comments":null,"resourceType":3,"resourceId":32311,"commentCount":1988,"likedCount":0,"shareCount":10339,"threadId":"R_AL_3_32311"}}}