<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="top.stillmisty.molia">

    <!-- Add necessary permissions -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- 系统媒体会话（flutter_media_session / Media3）：后台播放前台服务与
         媒体通知；POST_NOTIFICATIONS 由应用按业务时机（首次真正播放 /
         首次开启歌词输出）请求，不在冷启动时弹窗。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- 下载：dataSync 前台服务（进度通知 + 后台继续下载） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- 桌面歌词：悬浮窗（用户在系统设置中单独授权） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <!-- 应用内更新：下载 APK 后交给系统安装器（首次需用户在系统里允许未知来源） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- 跨设备同步（局域网直连）：Android 17 / API 37 起局域网访问默认阻断，
         访问局域网设备（含 UDP 单播与广播、对外 TCP 连接）需要该运行时权限；
         未授予时 Dart socket 直接抛 SocketException（见 ADR-0003 v2 §3）。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/launcher_icon"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true"
        android:localeConfig="@xml/locale_config"
        android:theme="@style/AppTheme">

        <!-- 让系统自动备份并恢复用户的语言偏好 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true"/>
        </service>

        <!-- 下载：进度通知 + 后台继续下载的 dataSync 前台服务（Dart 侧
             `lib/data/downloads/download_notifications*.dart` 驱动） -->
        <service
            android:name=".DownloadNotificationService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            tools:ignore="Instantiatable" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- 应用内更新：把 cache/updates 下的 APK 授权给系统安装器读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".MusicWidget" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>

        <!-- EmojiCompat 是给 Android TextView / AppCompat 用的；Flutter 文本由
             引擎自绘，原生只有 RemoteViews（系统 TextView），不需要它在每次
             进程启动时初始化并拉 emoji 字体。保留 InitializationProvider 的
             其余初始化项（ProcessLifecycle / ProfileInstaller）。 -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>

    </application>
</manifest>
